{
  "name": "@mastra/resonate",
  "version": "0.0.0",
  "description": "Mastra Resonate integration: run workflows on a Resonate durable execution server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "pretest": "docker compose up -d",
    "posttest": "docker compose down -v",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "dependencies": {
    "@resonatehq/sdk": "^0.11.5"
  },
  "devDependencies": {
    "@internal/core": "workspace:*",
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@internal/workflow-test-utils": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/libsql": "workspace:*",
    "@types/node": "22.20.1",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.78.0-0 <2.0.0-0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "workflows/resonate"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
